# Copy to .env and fill in values. Do NOT commit .env.

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
GENERATION_MODEL=qwen3
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024                 # confirm from BGE-M3 model card before backend pgvector migration

# ── DeepSeek (OPTIONAL hosted generation) ──────────────────
# Leave the key BLANK to disable: everything then runs on Ollama, exactly as before.
# Get a key at https://platform.deepseek.com/api_keys (prepaid credit, no subscription).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash   # NOT deepseek-chat — retired 2026-07-24. Flash, not Pro.
# ALLOWLIST of tasks allowed to leave this machine. Deny by default.
# Valid: interview, job_requirements, cover_letter, interview_feedback
# NEVER add a résumé task — those carry name/email/phone/employers.
DEEPSEEK_TASKS=interview,job_requirements
DEEPSEEK_MAX_TOKENS=1024           # spend guard: caps output per call

# ── Service-to-service auth ────────────────────────────────
# Must match AI_SERVICE_KEY in jobfit-backend. Sent as header: X-AI-Service-Key
AI_SERVICE_KEY=change-me

# ── Timeouts (seconds) ─────────────────────────────────────
REQUEST_TIMEOUT_GENERATE=60
REQUEST_TIMEOUT_EMBED=10
REQUEST_TIMEOUT_DEEPSEEK=30

# ── Server ─────────────────────────────────────────────────
PORT=8000
ENV=development
